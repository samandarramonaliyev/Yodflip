# Copy to .env for LOCAL development (never commit a real .env).
# Production values are set in the Render dashboard, see DEPLOY.md.

# --- Django ---------------------------------------------------------------
# Local dev needs DEBUG=true. With DEBUG=false the app REQUIRES SECRET_KEY and a
# PostgreSQL DATABASE_URL, and refuses to start without them.
DEBUG=true
SECRET_KEY=
# Neon / PostgreSQL connection string (keep ?sslmode=require). Empty locally = SQLite.
DATABASE_URL=
# Comma-separated; on Render the service hostname is added automatically.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# Public HTTPS URL of the site (Render sets RENDER_EXTERNAL_URL automatically).
# Used for the Telegram webhook and the Mini App button.
PUBLIC_URL=
TIME_ZONE=Asia/Tashkent
# Created during the build/start if missing
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- OCR (Anthropic Claude vision) ------------------------------------------
# Empty key: DEBUG -> sample data; production -> Tesseract if installed (not on Render's native runtime).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OCR_DAILY_LIMIT=20

# --- Neural text-to-speech -----------------------------------------------------
# Empty credentials -> browser voice. google | azure
TTS_PROVIDER=google
GOOGLE_TTS_CREDENTIALS_JSON=
AZURE_TTS_KEY=
AZURE_TTS_REGION=
TTS_DAILY_LIMIT=200
# Optional S3-compatible bucket for the audio
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Telegram (the bot runs inside Django, webhook mode) ---------------------
# From @BotFather. Empty -> no bot; with DEBUG=true the login page offers a demo Telegram login.
TELEGRAM_BOT_TOKEN=
# Bot username without @ (enables the Telegram Login Widget on the website)
TELEGRAM_BOT_USERNAME=
# Mini App short name from @BotFather /newapp (duel links t.me/<bot>/<short name>?startapp=...). Optional.
TELEGRAM_APP_SHORT_NAME=
# Seconds the bot quiz shows the answer before the next question
QUIZ_FEEDBACK_SECONDS=1.5
# Optional: secrets for /bot/webhook/<secret>/ and /bot/cron/<secret>/ (derived from SECRET_KEY if empty)
TELEGRAM_WEBHOOK_SECRET=
BOT_CRON_SECRET=
