# Copy to .env and fill in what you have. Everything is optional for local use:
# without keys the app runs in MOCK mode (sample OCR results, simulated Telegram login, no bot).

# --- Django ---------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=*
# Postgres in production. Leave empty locally to use SQLite (docker compose sets this for you).
DATABASE_URL=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://localhost:8080
TIME_ZONE=Asia/Tashkent
DJANGO_SUPERUSER_EMAIL=admin@wordflip.local
DJANGO_SUPERUSER_PASSWORD=admin12345

# --- OCR (Anthropic Claude vision) ------------------------------------------
# Empty -> OCR_MOCK mode (sample pairs). Set OCR_MOCK=false + no key -> Tesseract fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OCR_DAILY_LIMIT=20
# OCR_MOCK=false

# --- Telegram --------------------------------------------------------------
# From @BotFather. Empty -> bot is skipped and Telegram login runs in MOCK mode.
TELEGRAM_BOT_TOKEN=
# Bot username without @ (enables the Telegram Login Widget on the website)
TELEGRAM_BOT_USERNAME=
# Public HTTPS URL of the frontend (the Mini App URL you give to @BotFather)
WEBAPP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
# Shared secret between the bot and the backend's internal bot API
BOT_API_SECRET=change-me-bot-secret
