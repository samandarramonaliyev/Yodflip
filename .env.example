# Copy to .env for LOCAL development. Production values are set in the Render dashboard
# (see DEPLOY.md). Never commit a real .env.

# --- Django ---------------------------------------------------------------
# Local development needs DEBUG=true. Production (DEBUG=false) REQUIRES SECRET_KEY,
# DATABASE_URL (PostgreSQL) and BOT_API_SECRET, and refuses to start without them.
DEBUG=true
SECRET_KEY=
# PostgreSQL URL; leave empty locally to use SQLite (dev only)
DATABASE_URL=
# Comma-separated. On Render the service hostname is added automatically.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# Public URL of the site (Render sets RENDER_EXTERNAL_URL automatically)
PUBLIC_URL=
# Only when the frontend is hosted on another origin than the API:
CORS_ALLOWED_ORIGINS=
TIME_ZONE=Asia/Tashkent
# Created on startup if missing
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- OCR (Anthropic Claude vision) ------------------------------------------
# Empty key: DEBUG -> sample data (mock), production -> Tesseract fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OCR_DAILY_LIMIT=20
# OCR_MOCK=true

# --- Telegram --------------------------------------------------------------
# From @BotFather. Empty -> no bot; with DEBUG=true the login page offers a demo Telegram login.
TELEGRAM_BOT_TOKEN=
# Bot username without @ (enables the Telegram Login Widget on the website)
TELEGRAM_BOT_USERNAME=
# Shared secret between the bot and the backend (>= 16 chars in production)
BOT_API_SECRET=
# Bot only: public HTTPS URL of the Mini App, the backend URL, webhook settings
WEBAPP_URL=
BOT_BACKEND_URL=http://localhost:8000
# Empty -> polling mode (local). On Render, RENDER_EXTERNAL_URL is used automatically.
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# --- Frontend (build time) --------------------------------------------------
# Empty = same origin (recommended: Django serves the React build). Set only if the API is elsewhere.
VITE_API_URL=
